{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Template de Carga Manual e Eventos de Negócio",
  "description": "Schema para registrar eventos de carga manual com rastreabilidade completa.",
  "type": "object",
  "required": [
    "CNPJ",
    "DATA_DEMONSTRACAO_FINANCEIRA",
    "CAMPO_AFETADO",
    "VALOR_NOVO",
    "MOTIVO",
    "SOLICITANTE",
    "TIPO_EVENTO"
  ],
  "properties": {
    "CNPJ": {
      "type": "string"
    },
    "DATA_DEMONSTRACAO_FINANCEIRA": {
      "type": "string"
    },
    "CAMPO_AFETADO": {
      "type": "string"
    },
    "VALOR_NOVO": {
      "type": [
        "number",
        "string"
      ]
    },
    "MOTIVO": {
      "type": "string",
      "enum": [
        "Correcao de Falhas na Origem",
        "Atualizacao Historica",
        "Intervencao de Alcada (Override)",
        "Obtencao Tardia de Dados (Complementacao)",
        "Omissao no Envio de Documentos (Ausencia de DF)",
        "Outro"
      ]
    },
    "EVIDENCIA": {
      "type": "string"
    },
    "SOLICITANTE": {
      "type": "string",
      "enum": [
        "Malik Ribeiro Mourad",
        "Eduardo Suzuki Yamauti"
      ]
    },
    "TIPO_EVENTO": {
      "type": "string",
      "enum": [
        "AJUSTE_BALANCO",
        "RECLASSIFICACAO_SETORIAL",
        "RESTRITIVO_MANUAL",
        "CORRECAO",
        "OUTRO"
      ]
    }
  }
}