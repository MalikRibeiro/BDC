{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema_ficha_comercializadora_extraida.json",
  "title": "Schema da ficha de comercializadora extraída",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documento_id",
    "run_id",
    "ambiente",
    "tipo_ficha",
    "versao_ficha",
    "arquivo_nome",
    "hash_arquivo",
    "SIGLA",
    "CNPJ",
    "DATA_DEMONSTRACAO_FINANCEIRA"
  ],
  "properties": {
    "documento_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "dev",
        "test",
        "prod"
      ]
    },
    "tipo_ficha": {
      "type": "string",
      "const": "comercializadora"
    },
    "versao_ficha": {
      "type": "string",
      "enum": [
        "padrao_1",
        "padrao_2",
        "padrao_3",
        "padrao_4",
        "padrao_5",
        "padrao_6",
        "padrao_7"
      ]
    },
    "arquivo_nome": {
      "type": "string",
      "minLength": 1
    },
    "hash_arquivo": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "DATA_DEMONSTRACAO_FINANCEIRA": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "SIGLA": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "CNPJ": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{14}$"
    },
    "CODIGO_CCEE": {
      "type": [
        "string",
        "null"
      ]
    },
    "DATA_ADESAO_CCEE": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "AUDITOR": {
      "type": [
        "string",
        "null"
      ]
    },
    "TIPO_COMERCIALIZADORA": {
      "type": [
        "string",
        "null"
      ]
    },
    "PATRIMONIO_LIQUIDO": {
      "type": [
        "number",
        "null"
      ]
    },
    "AGENCIA": {
      "type": [
        "string",
        "null"
      ]
    },
    "NOTA_CREDITO": {
      "type": [
        "string",
        "null"
