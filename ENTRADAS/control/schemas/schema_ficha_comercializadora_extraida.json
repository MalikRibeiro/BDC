{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema_ficha_comercializadora_extraida.json",
  "title": "Schema da ficha de comercializadora extraída",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documento_id",
    "run_id",
    "ambiente",
    "TIPO_FICHA",
    "versao_ficha",
    "arquivo_nome",
    "hash_arquivo",
    "load_mode",
    "dt_processamento",
    "SIGLA",
    "CNPJ",
    "DATA_DEMONSTRACAO_FINANCEIRA"
  ],
  "properties": {
    "documento_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "dev",
        "test",
        "prod"
      ]
    },
    "TIPO_FICHA": {
      "type": "string",
      "const": "COMERCIALIZADORA"
    },
    "versao_ficha": {
      "type": "string",
      "enum": [
        "padrao_1",
        "padrao_2",
        "padrao_3",
        "padrao_4",
        "padrao_5",
        "padrao_6",
        "padrao_7"
      ]
    },
    "arquivo_nome": {
      "type": "string",
      "minLength": 1
    },
    "hash_arquivo": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "load_mode": {
      "type": "string"
    },
    "dt_processamento": {
      "type": "string",
      "format": "date-time"
    },
    "DATA_DEMONSTRACAO_FINANCEIRA": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "SIGLA": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "CNPJ": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{14}$"
    },
    "CODIGO_CCEE": {
      "type": [
        "string",
        "null"
      ]
    },
    "DATA_ADESAO_CCEE": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "AUDITOR": {
      "type": [
        "string",
        "null"
      ]
    },
    "TIPO_COMERCIALIZADORA": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "CPURA",
        "CGRUPO",
        "PURA",
        "GRUPO",
        null
      ]
    },
    "PATRIMONIO_LIQUIDO": {
      "type": [
        "number",
        "null"
      ]
    },
    "AGENCIA": {
      "type": [
        "string",
        "null"
      ]
